# Foundry project endpoint
FOUNDRY_PROJECT_ENDPOINT=https://<FOUNDRY_RESOURCE>.services.ai.azure.com/api/projects/<PROJECT_NAME>

# Model deployment
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini

# Foundry Toolbox name (must contain web_search + code_interpreter tools)
TOOLBOX_NAME=benefits-advisor-tools

# Foundry Skills (comma-separated names — must be provisioned first via provision_skills.py)
SKILL_NAMES=cost-analysis-methodology,regulatory-guidance-sgp
