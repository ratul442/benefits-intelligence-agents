# Foundry project endpoint
FOUNDRY_PROJECT_ENDPOINT=https://<FOUNDRY_RESOURCE>.services.ai.azure.com/api/projects/<PROJECT_NAME>

# Model deployment
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4
AZURE_OPENAI_ENDPOINT=https://<FOUNDRY_RESOURCE>.openai.azure.com/
AZURE_OPENAI_API_VERSION=<api-version>
AZURE_OPENAI_API_KEY=<api-key-or-empty-when-using-managed-identity>

# Agent behavior
MAX_CONCURRENT_TOPICS=9
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=16384
LLM_SEED=
LLM_TOP_P=
CATALOG_VERSION=glb-v1-standard-2026-07-31

# Deployment traceability
AGENT_VERSION=local
CONTAINER_TAG=local
FOUNDRY_AGENT_VERSION=local
PROMPT_VERSION=2026-11-extraction-accuracy-v3

# Observability
ENABLE_INSTRUMENTATION=false
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Local server
HOST=0.0.0.0
PORT=8080
